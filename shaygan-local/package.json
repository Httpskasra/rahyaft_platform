{
  "name": "shaygan-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "artifacts:generate": "tsx scripts/generate-artifacts.ts",
    "shaygan:probe": "tsx src/cli.ts probe",
    "shaygan:capture": "tsx src/cli.ts capture",
    "shaygan:verify": "tsx src/cli.ts verify",
    "shaygan:lan": "powershell -ExecutionPolicy Bypass -File scripts/run-lan-capture.ps1"
  },
  "dependencies": {
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
