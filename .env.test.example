# Core data services
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=enterprise
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
RABBITMQ_USER=app
RABBITMQ_PASS=CHANGE_ME_RABBIT_PASSWORD

# Auth
JWT_SECRET=CHANGE_ME_MIN_32_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARACTERS_DIFFERENT
JWT_REFRESH_EXPIRES_IN=7d

# Public application URL
# Frontend and API use the SAME hostname through Nginx.
NEXT_PUBLIC_API_URL=/api/v1
FRONTEND_URL=http://httpskasra.ir
PUBLIC_API_URL=http://httpskasra.ir

# Nginx / TLS
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_TEST_PORT=8080
# Start on HTTP. After the certificate is issued switch FRONTEND_URL/PUBLIC_API_URL to https and use nginx.https.conf.
NGINX_CONFIG_FILE=nginx.http.conf

# App
SWAGGER_ENABLED=false
API_VERSION=1.0.0
LOG_LEVEL=INFO
BALE_BOT_TOKEN=

# AvalAI - backend analytics
AI_ANALYTICS_BASE_URL=https://api.avalai.ir/v1
AI_ANALYTICS_API_KEY=CHANGE_ME_AVALAI_KEY
AI_ANALYTICS_MODEL=cf.gpt-oss-120b
AI_ANALYTICS_LANGUAGE=fa
AI_ANALYTICS_TIMEOUT_MS=45000
AI_ANALYTICS_MAX_OUTPUT_TOKENS=8192
AI_ANALYTICS_INCLUDE_IDENTIFIERS=false
AI_ANALYTICS_API_STYLE=auto

# AvalAI - CRM worker
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_API_KEY=CHANGE_ME_AVALAI_KEY
AVALAI_MODEL=cf.gpt-oss-120b
DOMAIN_EXCHANGE=domain_events
CRM_QUEUE=crm_ai_worker
