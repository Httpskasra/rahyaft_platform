# Copy this file to .env.test on the server, then replace all CHANGE_ME values.
POSTGRES_USER=app
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=enterprise

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

RABBITMQ_USER=app
RABBITMQ_PASS=CHANGE_ME_RABBIT_PASSWORD

JWT_SECRET=CHANGE_ME_MIN_32_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARACTERS_DIFFERENT
JWT_REFRESH_EXPIRES_IN=7d

# Phase 1: replace SERVER_IP with the public IPv4 of the Ubuntu server.
BACKEND_PORT=3000
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://SERVER_IP:3000/api/v1
FRONTEND_URL=http://SERVER_IP:3001
PUBLIC_API_URL=http://SERVER_IP:3000

SWAGGER_ENABLED=true
API_VERSION=1.0.0
LOG_LEVEL=INFO

# Optional Bale token. Bale tunnel/webhook are NOT part of phase 1 compose.
BALE_BOT_TOKEN=

# AvalAI for backend AI analytics
AI_ANALYTICS_BASE_URL=https://api.avalai.ir/v1
AI_ANALYTICS_API_KEY=CHANGE_ME_AVALAI_KEY
AI_ANALYTICS_MODEL=cf.gpt-oss-120b
AI_ANALYTICS_LANGUAGE=fa
AI_ANALYTICS_TIMEOUT_MS=45000
AI_ANALYTICS_MAX_OUTPUT_TOKENS=8192
AI_ANALYTICS_INCLUDE_IDENTIFIERS=false
AI_ANALYTICS_API_STYLE=auto

# AvalAI for CRM AI worker
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_API_KEY=CHANGE_ME_AVALAI_KEY
AVALAI_MODEL=cf.gpt-oss-120b

DOMAIN_EXCHANGE=domain_events
CRM_QUEUE=crm_ai_worker

# Phase 2 reverse proxy entrypoint. Browser traffic should use this port.
NGINX_PORT=8080
# Use same-origin API through Nginx; no hostname is baked into the frontend bundle.
# Replace any older NEXT_PUBLIC_API_URL=http://SERVER_IP:3000/api/v1 with this:
# NEXT_PUBLIC_API_URL=/api/v1
