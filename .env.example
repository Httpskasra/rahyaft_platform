# ─── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
POSTGRES_DB=enterprise

# ─── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=changeme_redis

# ─── RabbitMQ ──────────────────────────────────────────────────
RABBITMQ_USER=user
RABBITMQ_PASS=changeme_rabbit

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# ─── URLs ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# ─── Analytics ─────────────────────────────────────────────────
LOG_LEVEL=INFO



# crm
# Analytics database
DATABASE_URL=postgresql://app:app@localhost:5432/enterprise

# Analytics / CRM AI Worker
DOMAIN_EXCHANGE=domain_events
CRM_QUEUE=crm_ai_worker

# Ollama / Local LLM
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120

# Phase 5 - AI Analytics (OpenAI-compatible provider)
# Example base URL: https://your-provider.example/v1
AI_ANALYTICS_BASE_URL=
AI_ANALYTICS_API_KEY=
AI_ANALYTICS_MODEL=
AI_ANALYTICS_API_STYLE=auto
AI_ANALYTICS_LANGUAGE=fa
AI_ANALYTICS_TIMEOUT_MS=45000
AI_ANALYTICS_MAX_OUTPUT_TOKENS=8192
# Privacy-first default. Set true only when sending internal identifiers is acceptable.
AI_ANALYTICS_INCLUDE_IDENTIFIERS=false
