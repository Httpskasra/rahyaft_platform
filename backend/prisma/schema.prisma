generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ScopeType {
  SELF
  TEAM
  DEPARTMENT
  DEPARTMENT_SUBTREE
  RELATED_DEPARTMENTS
  ORG_WIDE
}

enum DepartmentRelationType {
  SUPPORTS
  COLLABORATES
  AUDITS
  SERVES
}

model Department {
  id       String  @id @default(uuid())
  name     String
  parentId String?

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")

  users             User[]
  outgoingRelations DepartmentRelation[] @relation("FromDepartment")
  incomingRelations DepartmentRelation[] @relation("ToDepartment")

  recruitmentJobOpenings JobOpening[]

  createdAt DateTime @default(now())
}

model DepartmentRelation {
  id               String                 @id @default(uuid())
  fromDepartmentId String
  toDepartmentId   String
  type             DepartmentRelationType

  fromDepartment Department @relation("FromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartment   Department @relation("ToDepartment", fields: [toDepartmentId], references: [id])

  @@unique([fromDepartmentId, toDepartmentId, type])
}

model User {
  id           String  @id @default(uuid())
  phoneNumber  String  @unique
  name         String
  departmentId String
  managerId    String?
  refreshToken String?

  department   Department       @relation(fields: [departmentId], references: [id])
  manager      User?            @relation("UserHierarchy", fields: [managerId], references: [id])
  subordinates User[]           @relation("UserHierarchy")
  roles        UserRole[]
  submissions  FormSubmission[]
  userInfo     UserInfo? //mehrak
  baleChatId   String? //mehrak

  createdAt DateTime @default(now())

  approvalActions ApprovalAction[]
  employeeCode    String?           @unique
  attendances     Attendance[]
  assignedRepairs RepairCase[]      @relation("TechnicianRepairs")
  repairVisits    RepairVisit[]     @relation("TechnicianVisits")
  statusLogs      RepairStatusLog[] @relation("UserStatusChanges")

  recruitmentAssignments RecruitmentAssignment[] @relation("RecruitmentAssignee")
  recruitmentAssignedBy RecruitmentAssignment[] @relation("RecruitmentAssignedBy")
  recruitmentTransitions RecruitmentTransition[]
  recruitmentSubmissions RecruitmentFormSubmission[]
  recruitmentFinalized   RecruitmentApplication[] @relation("RecruitmentFinalUser")
}

model Attendance {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  checkTime DateTime
  source    String   @default("excel-import")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, checkTime])
  @@index([userId, date])
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  permissions RolePermission[]
  users       UserRole[]

  approvalSteps ApprovalStep[]
}

model Permission {
  id       String @id @default(uuid())
  action   String
  resource String

  roles RolePermission[]

  @@unique([action, resource])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  id           String                  @id @default(uuid())
  roleId       String
  permissionId String
  scope        ScopeType
  relationType DepartmentRelationType?
  constraints  Json?

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// ─── Forms & Analytics ────────────────────────────────────────

model Form {
  id       String  @id @default(uuid())
  ownerId  String
  customId String? @unique // ← شناسه دستی یکتا

  name        String
  description String?
  schema      Json
  version     Int     @default(1)
  isActive    Boolean @default(true)

  submissions FormSubmission[]
  stats       FormStat[]
  analysis    FormAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvalPolicies ApprovalPolicy[]
}

model FormSubmission {
  id          String  @id @default(uuid())
  formId      String
  formVersion Int
  userId      String?
  data        Json

  form Form  @relation(fields: [formId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  approvalInstances ApprovalInstance[]
}

model FormStat {
  id      String @id @default(uuid())
  formId  String
  fieldId String
  metric  String
  value   Json

  form Form @relation(fields: [formId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([formId, fieldId, metric])
}

model FormAnalysis {
  id      String  @id @default(uuid())
  formId  String
  fieldId String?
  metric  String
  value   Json
  source  String  @default("analytics-worker")

  form Form @relation(fields: [formId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, fieldId, metric])
  @@index([formId])
}

// ─── Approval Workflow ────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalPolicy {
  id        String   @id @default(uuid())
  formId    String   @unique
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ApprovalStep[]
}

model ApprovalStep {
  id              String           @id @default(uuid())
  policyId        String
  policy          ApprovalPolicy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  stepOrder       Int
  roleId          String
  role            Role             @relation(fields: [roleId], references: [id])
  createdAt       DateTime         @default(now())
  approvalActions ApprovalAction[]

  @@unique([policyId, stepOrder])
}

model ApprovalInstance {
  id               String         @id @default(uuid())
  submissionId     String         @unique
  submission       FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status           ApprovalStatus @default(PENDING)
  currentStepOrder Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  actions ApprovalAction[]
}

model ApprovalAction {
  id         String           @id @default(uuid())
  instanceId String
  instance   ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId     String
  step       ApprovalStep     @relation(fields: [stepId], references: [id])
  approverId String
  approver   User             @relation(fields: [approverId], references: [id])
  action     ApprovalStatus
  comments   String?
  createdAt  DateTime         @default(now())
}

// ─── User Info & Relatives ────────────────────────────────────────mehrak
model UserInfo {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // مشخصات فردی
  firstName    String?
  lastName     String?
  fatherName   String?
  birthDate    String?
  nationalCode String? @unique
  birthPlace   String?
  residence    String?
  mobile       String?
  homePhone    String?

  // مشخصات تحصیلی
  degree       String?
  university   String?
  graduateYear String?

  relatives Relative[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Relative {
  id         String   @id @default(uuid())
  userInfoId String
  userInfo   UserInfo @relation(fields: [userInfoId], references: [id], onDelete: Cascade)

  name     String
  relation String // مثلاً: پدر، مادر، برادر
  address  String?
  phone    String?
}

model RepairCase {
  id String @id @default(uuid())

  caseNumber String @unique

  customerId String

  type RepairType

  status RepairStatus

  technicianId String?

  description String?

  needCostApproval Boolean @default(false)

  estimatedCost Decimal? @db.Decimal(12, 2)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deviceTitle String

  serialNumber String?

  problemDescription String
  customer           Customer      @relation(fields: [customerId], references: [id])
  technician         User?         @relation("TechnicianRepairs", fields: [technicianId], references: [id])
  visits             RepairVisit[]

  parts      RepairItem[]
  statusLogs RepairStatusLog[]
  // notificationEvents NotificationEvent[]
  // sla RepairSla?
}

model RepairItem {
  id String @id @default(uuid())

  repairCaseId String

  title String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  description String?

  createdAt DateTime @default(now())

  repairCase RepairCase @relation(fields: [repairCaseId], references: [id])
}

enum RepairType {
  IN_HOUSE
  ON_SITE
}

enum RepairStatus {
  REGISTERED

  WAITING_REVIEW

  WAITING_COST_APPROVAL

  APPROVED

  REJECTED

  IN_REPAIR

  QC

  READY_FOR_DELIVERY

  DELIVERED

  CLOSED

  CANCELED

  NO_REPAIR_REQUIRED
}

model RepairVisit {
  id String @id @default(uuid())

  repairCaseId String

  technicianId String

  technician User @relation("TechnicianVisits", fields: [technicianId], references: [id])

  scheduledAt DateTime

  visitedAt DateTime?

  notes String?

  result VisitResult

  createdAt DateTime @default(now())

  repairCase RepairCase @relation(fields: [repairCaseId], references: [id])
}

enum VisitResult {
  REPAIRED
  NEED_SECOND_VISIT
  NEED_PART
  CUSTOMER_ABSENT
  CANCELED
}

model RepairStatusLog {
  id String @id @default(uuid())

  repairCaseId String

  oldStatus RepairStatus?

  newStatus RepairStatus

  changedById String

  reason String?

  createdAt DateTime @default(now())

  repairCase RepairCase @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)

  changedBy User @relation("UserStatusChanges", fields: [changedById], references: [id])
}

model RepairSla {
  id String @id @default(uuid())

  repairCaseId String @unique

  dueAt DateTime

  completedAt DateTime?

  isBreached Boolean @default(false)
}

model NotificationEvent {
  id String @id @default(uuid())

  repairCaseId String

  status RepairStatus

  payload Json

  sentAt DateTime?

  createdAt DateTime @default(now())
}

enum Gender {
  MALE
  FEMALE
}

enum CustomerType {
  PERSON
  ORGANIZATION
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum OccupationGroup {
  HAIR_TRANSPLANT_TECHNICIAN // تکنسین کاشت مو
  NAIL_TECHNICIAN // تکنسین کاشت ناخن
  GENERAL_PRACTITIONER // پزشک عمومی
  PHYSICIAN // پزشک
  HAIR_BEAUTY_CLINIC // کلینیک کاشت مو و زیبایی
  HOME_DEVICE_CUSTOMER // مشتری حضوری دستگاه خانگی
  BARBER // آرایشگر
  DENTIST // دندانپزشک
  VETERINARIAN // دامپزشک
  COLLEAGUE // همکار
  EMPLOYEE // کارمند
  DERMATOLOGIST // متخصص پوست و مو
  GYNECOLOGIST // متخصص زنان
  OTHER // سایر
}

enum SalesOpportunityStatus {
  NEW
  CONTACTED
  NEEDS_QUOTE
  QUOTED
  NEGOTIATION
  WON
  LOST
  CANCELED
}

enum SalesOpportunityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CustomerActivityType {
  NOTE
  CALL
  SMS
  VISIT
  FOLLOW_UP

  CUSTOMER_CREATED
  CUSTOMER_UPDATED

  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED

  SALES_OPPORTUNITY_CREATED
  SALES_OPPORTUNITY_UPDATED
  SALES_OPPORTUNITY_DELETED

  REPAIR_CREATED
  REPAIR_STATUS_CHANGED

  AI_ANALYSIS_UPDATED
}

enum AiInsightLevel {
  LOW
  MEDIUM
  HIGH
}

model Customer {
  id String @id @default(uuid())

  // نوع مشتری: شخص حقیقی یا سازمان
  type   CustomerType   @default(PERSON)
  status CustomerStatus @default(ACTIVE)

  // اطلاعات شخص حقیقی
  firstName    String?
  lastName     String?
  nationalCode String? @unique
  birthDate    String?
  gender       Gender?

  // اطلاعات سازمان / شرکت / کلینیک
  organizationName String?
  economicCode     String? @unique
  registrationNo   String? @unique
  nationalId       String? @unique

  // اطلاعات تماس مشترک
  mobile     String?
  phone      String?
  email      String?
  province   String?
  city       String?
  address    String?
  postalCode String?

  // دسته‌بندی کاری مشتری برای کارفرما
  occupation      String?
  occupationGroup OccupationGroup?

  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  repairs            RepairCase[]
  contacts           CustomerContact[]
  salesOpportunities SalesOpportunity[]
  activities         CustomerActivity[]
  aiAnalyses         CustomerAiAnalysis[]

  @@index([type])
  @@index([status])
  @@index([mobile])
  @@index([phone])
  @@index([email])
  @@index([organizationName])
  @@index([firstName, lastName])
  @@index([occupationGroup])
}

model CustomerContact {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  fullName  String
  role      String?
  mobile    String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([mobile])
  @@index([email])
}

model SalesOpportunity {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title       String
  description String?

  status   SalesOpportunityStatus   @default(NEW)
  priority SalesOpportunityPriority @default(MEDIUM)

  estimatedValue Decimal? @db.Decimal(12, 2)
  probability    Int?     @default(0)

  expectedCloseAt DateTime?
  nextFollowUpAt  DateTime?

  lossReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([nextFollowUpAt])
  @@index([expectedCloseAt])
}

model CustomerActivity {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type  CustomerActivityType
  title String
  body  String?

  relatedRepairId           String?
  relatedSalesOpportunityId String?

  dueAt DateTime?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
  @@index([dueAt])
  @@index([relatedRepairId])
  @@index([relatedSalesOpportunityId])
}

model CustomerAiAnalysis {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  summary        String
  riskLevel      AiInsightLevel?
  salesPotential AiInsightLevel?
  nextBestAction String?

  tags     Json?
  insights Json?

  source    String  @default("manual")
  modelName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([riskLevel])
  @@index([salesPotential])
  @@index([createdAt])
}


// ─── Recruitment (independent from internal Forms) ──────────────

enum RecruitmentFormType {
  PRE_INTERVIEW
  INITIAL_INTERVIEW
  TECHNICAL_INTERVIEW
  SUPERADMIN_REVIEW
  PROFILE_COMPLETION
}

enum RecruitmentApplicationStatus {
  DRAFT
  IN_PROGRESS
  REJECTED
  WITHDRAWN
  HIRED
  CANCELLED
}

enum RecruitmentStage {
  PRE_INTERVIEW_FORM
  INITIAL_REVIEW
  INITIAL_INTERVIEW
  TECHNICAL_INTERVIEW_ASSIGNMENT
  TECHNICAL_INTERVIEW
  SUPERADMIN_APPROVAL
  ACCOUNT_PROVISIONING
  PROFILE_COMPLETION
  COMPLETED
}

enum RecruitmentActorType {
  APPLICANT
  USER
  SYSTEM
}

enum RecruitmentAction {
  SUBMIT_PRE_INTERVIEW
  APPROVE_INITIAL_REVIEW
  REJECT_INITIAL_REVIEW
  SUBMIT_INITIAL_INTERVIEW
  APPROVE_INITIAL_INTERVIEW
  REJECT_INITIAL_INTERVIEW
  ASSIGN_TECHNICAL_INTERVIEWER
  SUBMIT_TECHNICAL_INTERVIEW
  APPROVE_TECHNICAL_INTERVIEW
  REJECT_TECHNICAL_INTERVIEW
  FINAL_APPROVE
  FINAL_REJECT
  CREATE_USER_ACCOUNT
  COMPLETE_PROFILE
  WITHDRAW
  REASSIGN
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

model RecruitmentFormTemplate {
  id          String @id @default(uuid())
  name        String
  description String?
  type        RecruitmentFormType
  isActive    Boolean @default(true)
  versions    RecruitmentFormVersion[]
  jobOpeningsPre       JobOpening[] @relation("PreInterviewForm")
  jobOpeningsInitial   JobOpening[] @relation("InitialInterviewForm")
  jobOpeningsTechnical JobOpening[] @relation("TechnicalInterviewForm")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([type, isActive])
}

model RecruitmentFormVersion {
  id          String @id @default(uuid())
  templateId  String
  version     Int
  schema      Json
  isPublished Boolean @default(false)
  publishedAt DateTime?
  template RecruitmentFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissions RecruitmentFormSubmission[]
  createdAt DateTime @default(now())
  @@unique([templateId, version])
  @@index([templateId, isPublished])
}

model JobOpening {
  id           String @id @default(uuid())
  title        String
  slug         String @unique
  description  String?
  departmentId String?
  isActive     Boolean @default(true)
  preInterviewFormId String
  initialInterviewFormId String?
  technicalInterviewFormId String?
  initialReviewerRoleId String?
  department Department? @relation(fields: [departmentId], references: [id])
  preInterviewForm RecruitmentFormTemplate @relation("PreInterviewForm", fields: [preInterviewFormId], references: [id])
  initialInterviewForm RecruitmentFormTemplate? @relation("InitialInterviewForm", fields: [initialInterviewFormId], references: [id])
  technicalInterviewForm RecruitmentFormTemplate? @relation("TechnicalInterviewForm", fields: [technicalInterviewFormId], references: [id])
  applications RecruitmentApplication[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([isActive])
}

model RecruitmentApplicant {
  id              String @id @default(uuid())
  fullName        String
  phoneNumber     String
  normalizedPhone String
  email           String?
  nationalCode    String?
  applications RecruitmentApplication[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([normalizedPhone])
  @@index([nationalCode])
}

model RecruitmentApplication {
  id           String @id @default(uuid())
  trackingCode String @unique
  publicTokenHash String @unique
  applicantId  String
  jobOpeningId String
  status       RecruitmentApplicationStatus @default(IN_PROGRESS)
  currentStage RecruitmentStage @default(INITIAL_REVIEW)
  finalUserId  String? @unique
  rejectionReasonInternal String?
  rejectionMessagePublic String?
  version Int @default(0)
  submittedAt DateTime @default(now())
  rejectedAt DateTime?
  hiredAt DateTime?
  applicant RecruitmentApplicant @relation(fields: [applicantId], references: [id])
  jobOpening JobOpening @relation(fields: [jobOpeningId], references: [id])
  finalUser User? @relation("RecruitmentFinalUser", fields: [finalUserId], references: [id])
  submissions RecruitmentFormSubmission[]
  assignments RecruitmentAssignment[]
  transitions RecruitmentTransition[]
  technicalEvaluation TechnicalInterviewEvaluation?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, currentStage])
  @@index([jobOpeningId, createdAt])
}

model RecruitmentFormSubmission {
  id            String @id @default(uuid())
  applicationId String
  formVersionId String
  stage         RecruitmentStage
  answers       Json
  submittedByType RecruitmentActorType
  submittedByUserId String?
  application RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  formVersion RecruitmentFormVersion @relation(fields: [formVersionId], references: [id])
  submittedByUser User? @relation(fields: [submittedByUserId], references: [id])
  createdAt DateTime @default(now())
  @@unique([applicationId, stage])
  @@index([formVersionId])
}

model RecruitmentAssignment {
  id String @id @default(uuid())
  applicationId String
  stage RecruitmentStage
  assigneeUserId String
  assignedByUserId String
  assignedAt DateTime @default(now())
  completedAt DateTime?
  revokedAt DateTime?
  application RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignee User @relation("RecruitmentAssignee", fields: [assigneeUserId], references: [id])
  assignedBy User @relation("RecruitmentAssignedBy", fields: [assignedByUserId], references: [id])
  @@index([assigneeUserId, stage, completedAt])
  @@index([applicationId, stage])
}

model RecruitmentTransition {
  id String @id @default(uuid())
  applicationId String
  fromStage RecruitmentStage?
  toStage RecruitmentStage
  action RecruitmentAction
  actorType RecruitmentActorType
  actorUserId String?
  reasonCode String?
  comment String?
  metadata Json?
  application RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUser User? @relation(fields: [actorUserId], references: [id])
  createdAt DateTime @default(now())
  @@index([applicationId, createdAt])
}

model TechnicalInterviewEvaluation {
  id String @id @default(uuid())
  applicationId String @unique
  interviewerId String
  overallScore Int
  recommendation InterviewRecommendation
  internalSummary String
  completedAt DateTime @default(now())
  application RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([interviewerId])
}
