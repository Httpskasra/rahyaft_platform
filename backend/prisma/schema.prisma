generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ScopeType {
  SELF
  TEAM
  DEPARTMENT
  DEPARTMENT_SUBTREE
  RELATED_DEPARTMENTS
  ORG_WIDE
}

enum DepartmentRelationType {
  SUPPORTS
  COLLABORATES
  AUDITS
  SERVES
}

model Department {
  id       String  @id @default(uuid())
  name     String
  parentId String?

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")

  users             User[]
  outgoingRelations DepartmentRelation[] @relation("FromDepartment")
  incomingRelations DepartmentRelation[] @relation("ToDepartment")

  recruitmentJobOpenings JobOpening[]
  communicationThreads   Thread[]

  createdAt DateTime @default(now())
}

model DepartmentRelation {
  id               String                 @id @default(uuid())
  fromDepartmentId String
  toDepartmentId   String
  type             DepartmentRelationType

  fromDepartment Department @relation("FromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartment   Department @relation("ToDepartment", fields: [toDepartmentId], references: [id])

  @@unique([fromDepartmentId, toDepartmentId, type])
}

model User {
  id                      String                   @id @default(uuid())
  phoneNumber             String                   @unique
  name                    String
  departmentId            String
  managerId               String?
  refreshToken            String?
  signatureStorageKey     String?
  signatureMimeType       String?
  signatureChangeRequests SignatureChangeRequest[] @relation("SignatureChangeRequester")
  signatureChangeReviews  SignatureChangeRequest[] @relation("SignatureChangeReviewer")

  department   Department       @relation(fields: [departmentId], references: [id])
  manager      User?            @relation("UserHierarchy", fields: [managerId], references: [id])
  subordinates User[]           @relation("UserHierarchy")
  roles        UserRole[]
  submissions  FormSubmission[]
  userInfo     UserInfo? //mehrak
  baleChatId   String? //mehrak

  createdAt DateTime @default(now())

  approvalActions ApprovalAction[]
  employeeCode    String?           @unique
  attendances     Attendance[]
  assignedRepairs RepairCase[]      @relation("TechnicianRepairs")
  repairVisits    RepairVisit[]     @relation("TechnicianVisits")
  statusLogs      RepairStatusLog[] @relation("UserStatusChanges")

  recruitmentAssignments RecruitmentAssignment[]     @relation("RecruitmentAssignee")
  recruitmentAssignedBy  RecruitmentAssignment[]     @relation("RecruitmentAssignedBy")
  recruitmentTransitions RecruitmentTransition[]
  recruitmentSubmissions RecruitmentFormSubmission[]
  recruitmentFinalized   RecruitmentApplication[]    @relation("RecruitmentFinalUser")

  createdThreads                Thread[]                    @relation("ThreadCreator")
  threadParticipants            ThreadParticipant[]
  sentThreadMessages            ThreadMessage[]
  threadAssignments             ThreadAssignment[]          @relation("ThreadAssignee")
  assignedThreads               ThreadAssignment[]          @relation("ThreadAssignedBy")
  threadActivities              ThreadActivity[]
  threadMentions                ThreadMention[]
  threadNotifications           CommunicationNotification[]
  notifications                 AppNotification[]
  threadAttachments             ThreadAttachment[]
  threadEntityLinks             ThreadEntityLink[]
  productionFlowsCreated        ProductionFlow[]            @relation("ProductionFlowCreator")
  productionRunsStarted         ProductionRun[]             @relation("ProductionRunStarter")
  productionFlowStepsAssigned   ProductionFlowStep[]        @relation("ProductionFlowStepAssignee")
  productionFlowStepsSupervised ProductionFlowStep[]        @relation("ProductionFlowStepSupervisor")
  productionFlowStepsApproved   ProductionFlowStep[]        @relation("ProductionFlowStepApprover")
  productionStepsAssigned       ProductionRunStep[]         @relation("ProductionRunStepAssignee")
  productionStepsSupervised     ProductionRunStep[]         @relation("ProductionRunStepSupervisor")
  productionStepsApproved       ProductionRunStep[]         @relation("ProductionRunStepApprover")
  productionReviews             ProductionStepReview[]      @relation("ProductionStepReviewer")
  productionFlowsQcOwned        ProductionFlow[]            @relation("ProductionFlowQcAssignee")
  productionRunsQcAssigned      ProductionRun[]             @relation("ProductionRunQcAssignee")
  productionRunsQcReviewed      ProductionRun[]             @relation("ProductionRunQcReviewer")
  keptWarehouses                Warehouse[]                 @relation("WarehouseKeeper")
  purchaseRequests              PurchaseRequest[]           @relation("PurchaseRequester")
  purchaseOrdersRequested       PurchaseOrder[]             @relation("PurchaseOrderRequester")
  purchaseOrdersBought          PurchaseOrder[]             @relation("PurchaseOrderBuyer")
  stockTransfersRequested       StockTransfer[]             @relation("TransferRequester")
  outboundRequests              OutboundRequest[]           @relation("OutboundRequester")
}

enum SignatureChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model SignatureChangeRequest {
  id            String                       @id @default(uuid())
  requesterId   String
  reviewerId    String
  storageKey    String
  mimeType      String
  status        SignatureChangeRequestStatus @default(PENDING)
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  requester User @relation("SignatureChangeRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User @relation("SignatureChangeReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([reviewerId, status, createdAt])
  @@index([requesterId, status, createdAt])
}

enum ThreadType {
  CONVERSATION
  REQUEST
  TASK
  REFERRAL
  ANNOUNCEMENT
  CASE
}

enum ThreadStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
  ARCHIVED
}

enum ThreadPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ThreadParticipantRole {
  OWNER
  ASSIGNEE
  PARTICIPANT
  WATCHER
}

enum ThreadEntityType {
  CUSTOMER
  REPAIR
  FORM
  FORM_SUBMISSION
  SALES_OPPORTUNITY
  USER
  DEPARTMENT
}

enum ThreadActivityType {
  THREAD_CREATED
  MESSAGE_SENT
  USER_ADDED
  USER_REMOVED
  ASSIGNEE_ADDED
  ASSIGNEE_REMOVED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  THREAD_UPDATED
  ENTITY_LINKED
  ENTITY_UNLINKED
}

model Thread {
  id           String         @id @default(uuid())
  title        String
  type         ThreadType
  status       ThreadStatus   @default(OPEN)
  priority     ThreadPriority @default(NORMAL)
  creatorId    String
  departmentId String?
  dueAt        DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  creator       User                        @relation("ThreadCreator", fields: [creatorId], references: [id])
  department    Department?                 @relation(fields: [departmentId], references: [id])
  participants  ThreadParticipant[]
  messages      ThreadMessage[]
  assignments   ThreadAssignment[]
  activities    ThreadActivity[]
  attachments   ThreadAttachment[]
  notifications CommunicationNotification[]
  entityLinks   ThreadEntityLink[]

  @@index([status])
  @@index([creatorId])
  @@index([departmentId])
  @@index([updatedAt])
}

model ThreadEntityLink {
  id          String           @id @default(uuid())
  threadId    String
  entityType  ThreadEntityType
  entityId    String
  label       String
  subtitle    String?
  href        String?
  createdById String?
  createdAt   DateTime         @default(now())

  thread    Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([threadId, entityType, entityId])
  @@index([entityType, entityId])
  @@index([threadId, createdAt])
}

model ThreadParticipant {
  id         String                @id @default(uuid())
  threadId   String
  userId     String
  role       ThreadParticipantRole @default(PARTICIPANT)
  joinedAt   DateTime              @default(now())
  leftAt     DateTime?
  lastReadAt DateTime?

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId, leftAt])
}

model ThreadAssignment {
  id           String    @id @default(uuid())
  threadId     String
  userId       String
  assignedById String
  assignedAt   DateTime  @default(now())
  completedAt  DateTime?

  thread     Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  assignee   User   @relation("ThreadAssignee", fields: [userId], references: [id])
  assignedBy User   @relation("ThreadAssignedBy", fields: [assignedById], references: [id])

  @@index([threadId, userId, completedAt])
  @@index([userId, completedAt])
}

model ThreadMessage {
  id        String    @id @default(uuid())
  threadId  String
  senderId  String
  clientId  String?
  replyToId String?
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  thread      Thread             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender      User               @relation(fields: [senderId], references: [id])
  replyTo     ThreadMessage?     @relation("ThreadMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies     ThreadMessage[]    @relation("ThreadMessageReplies")
  mentions    ThreadMention[]
  attachments ThreadAttachment[]

  @@unique([senderId, clientId])
  @@index([threadId, createdAt])
  @@index([replyToId])
}

model ThreadMention {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  createdAt DateTime @default(now())

  message ThreadMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, createdAt])
}

model ThreadAttachment {
  id         String   @id @default(uuid())
  threadId   String
  messageId  String?
  uploaderId String
  fileName   String
  mimeType   String
  size       Int
  storageKey String   @unique
  createdAt  DateTime @default(now())

  thread   Thread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message  ThreadMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploader User           @relation(fields: [uploaderId], references: [id])

  @@index([threadId, createdAt])
  @@index([messageId])
}

model CommunicationNotification {
  id        String    @id @default(uuid())
  userId    String
  threadId  String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([threadId, createdAt])
}

model AppNotification {
  id                String    @id @default(uuid())
  userId            String
  type              String
  category          String
  title             String
  body              String?
  href              String?
  entityType        String?
  entityId          String?
  actorId           String?
  metadata          Json?
  readAt            DateTime?
  createdAt         DateTime  @default(now())
  baleStatus        String    @default("PENDING") // PENDING, SENDING, SENT, SKIPPED, FAILED
  baleAttempts      Int       @default(0)
  baleNextAttemptAt DateTime  @default(now())
  baleSentAt        DateTime?
  baleLastError     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, category, createdAt])
  @@index([entityType, entityId])
  @@index([baleStatus, baleNextAttemptAt])
}

model ThreadActivity {
  id        String             @id @default(uuid())
  threadId  String
  actorId   String?
  type      ThreadActivityType
  metadata  Json?
  createdAt DateTime           @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([threadId, createdAt])
}

model Attendance {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  checkTime DateTime
  source    String   @default("excel-import")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, checkTime])
  @@index([userId, date])
}

model Role {
  id   String @id @default(uuid())
  name String @unique

  permissions RolePermission[]
  users       UserRole[]

  approvalSteps ApprovalStep[]
}

model Permission {
  id       String @id @default(uuid())
  action   String
  resource String

  roles RolePermission[]

  @@unique([action, resource])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  id           String                  @id @default(uuid())
  roleId       String
  permissionId String
  scope        ScopeType
  relationType DepartmentRelationType?
  constraints  Json?

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// ─── Forms & Analytics ────────────────────────────────────────

model Form {
  id       String  @id @default(uuid())
  ownerId  String
  customId String? @unique // ← شناسه دستی یکتا

  name        String
  description String?
  schema      Json
  version     Int     @default(1)
  isActive    Boolean @default(true)
  slaHours    Int?

  submissions FormSubmission[]
  stats       FormStat[]
  analysis    FormAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvalPolicies ApprovalPolicy[]
  productionSteps  ProductionFlowStep[]
}

model FormSubmission {
  id          String  @id @default(uuid())
  formId      String
  formVersion Int
  userId      String?
  data        Json

  form Form  @relation(fields: [formId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  approvalInstances ApprovalInstance[]
  productionRunStep ProductionRunStep?
}

model FormStat {
  id      String @id @default(uuid())
  formId  String
  fieldId String
  metric  String
  value   Json

  form Form @relation(fields: [formId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([formId, fieldId, metric])
}

model FormAnalysis {
  id      String  @id @default(uuid())
  formId  String
  fieldId String?
  metric  String
  value   Json
  source  String  @default("analytics-worker")

  form Form @relation(fields: [formId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, fieldId, metric])
  @@index([formId])
}

// ─── Production Flow / Pipeline ──────────────────────────────────

enum ProductionRunStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum ProductionRunStepStatus {
  LOCKED
  READY
  IN_PROGRESS
  WAITING_SUPERVISOR
  WAITING_APPROVAL
  NEEDS_REVISION
  COMPLETED
  SKIPPED
}

enum ProductionReviewType {
  SUPERVISOR
  APPROVER
}

enum ProductionReviewAction {
  APPROVED
  REJECTED
}

enum ProductionQcStatus {
  NOT_REQUIRED
  PENDING
  PASSED
  FAILED
}

model ProductionFlow {
  id           String   @id @default(uuid())
  name         String
  code         String?  @unique
  description  String?
  isActive     Boolean  @default(true)
  requiresQc   Boolean  @default(false)
  qcAssigneeId String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy  User                 @relation("ProductionFlowCreator", fields: [createdById], references: [id])
  qcAssignee User?                @relation("ProductionFlowQcAssignee", fields: [qcAssigneeId], references: [id])
  steps      ProductionFlowStep[]
  runs       ProductionRun[]

  @@index([createdById])
  @@index([isActive])
}

model ProductionFlowStep {
  id                String   @id @default(uuid())
  flowId            String
  stepOrder         Int
  name              String
  description       String?
  formId            String
  assigneeUserId    String
  supervisorUserId  String?
  approverUserId    String?
  estimatedMinutes  Int?
  checklistTemplate Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  flow       ProductionFlow      @relation(fields: [flowId], references: [id], onDelete: Cascade)
  form       Form                @relation(fields: [formId], references: [id])
  assignee   User                @relation("ProductionFlowStepAssignee", fields: [assigneeUserId], references: [id])
  supervisor User?               @relation("ProductionFlowStepSupervisor", fields: [supervisorUserId], references: [id])
  approver   User?               @relation("ProductionFlowStepApprover", fields: [approverUserId], references: [id])
  runSteps   ProductionRunStep[]

  @@unique([flowId, stepOrder])
  @@index([formId])
  @@index([assigneeUserId])
}

model ProductionRun {
  id               String              @id @default(uuid())
  flowId           String
  title            String
  productName      String
  productCode      String?
  serialNumber     String?             @unique
  batchNumber      String?
  quantity         Int                 @default(1)
  dueDate          DateTime?
  referenceNo      String              @unique
  status           ProductionRunStatus @default(IN_PROGRESS)
  currentStepOrder Int?
  startedById      String
  startedAt        DateTime            @default(now())
  completedAt      DateTime?
  cancelledAt      DateTime?
  metadata         Json?
  qcStatus         ProductionQcStatus  @default(NOT_REQUIRED)
  qcAssigneeId     String?
  qcReviewerId     String?
  qcNotes          String?
  qcReviewedAt     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  flow       ProductionFlow      @relation(fields: [flowId], references: [id])
  startedBy  User                @relation("ProductionRunStarter", fields: [startedById], references: [id])
  qcAssignee User?               @relation("ProductionRunQcAssignee", fields: [qcAssigneeId], references: [id])
  qcReviewer User?               @relation("ProductionRunQcReviewer", fields: [qcReviewerId], references: [id])
  steps      ProductionRunStep[]

  @@index([flowId, status])
  @@index([startedById])
  @@index([updatedAt])
  @@index([serialNumber])
  @@index([batchNumber])
  @@index([qcStatus])
}

model ProductionRunStep {
  id               String                  @id @default(uuid())
  runId            String
  flowStepId       String
  stepOrder        Int
  name             String
  description      String?
  formId           String
  assigneeUserId   String
  supervisorUserId String?
  approverUserId   String?
  status           ProductionRunStepStatus @default(LOCKED)
  submissionId     String?                 @unique
  attempt          Int                     @default(0)
  startedAt        DateTime?
  submittedAt      DateTime?
  completedAt      DateTime?
  checklist        Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  run        ProductionRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  flowStep   ProductionFlowStep     @relation(fields: [flowStepId], references: [id])
  assignee   User                   @relation("ProductionRunStepAssignee", fields: [assigneeUserId], references: [id])
  supervisor User?                  @relation("ProductionRunStepSupervisor", fields: [supervisorUserId], references: [id])
  approver   User?                  @relation("ProductionRunStepApprover", fields: [approverUserId], references: [id])
  submission FormSubmission?        @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  reviews    ProductionStepReview[]

  @@unique([runId, stepOrder])
  @@index([assigneeUserId, status])
  @@index([supervisorUserId, status])
  @@index([approverUserId, status])
}

model ProductionStepReview {
  id         String                 @id @default(uuid())
  runStepId  String
  reviewerId String
  type       ProductionReviewType
  action     ProductionReviewAction
  comment    String?
  createdAt  DateTime               @default(now())

  runStep  ProductionRunStep @relation(fields: [runStepId], references: [id], onDelete: Cascade)
  reviewer User              @relation("ProductionStepReviewer", fields: [reviewerId], references: [id])

  @@index([runStepId, createdAt])
  @@index([reviewerId])
}

// ─── Approval Workflow ────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalPolicy {
  id        String   @id @default(uuid())
  formId    String   @unique
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ApprovalStep[]
}

model ApprovalStep {
  id              String           @id @default(uuid())
  policyId        String
  policy          ApprovalPolicy   @relation(fields: [policyId], references: [id], onDelete: Cascade)
  stepOrder       Int
  roleId          String
  role            Role             @relation(fields: [roleId], references: [id])
  createdAt       DateTime         @default(now())
  slaHours        Int?
  approvalActions ApprovalAction[]

  @@unique([policyId, stepOrder])
}

model ApprovalInstance {
  id               String         @id @default(uuid())
  submissionId     String         @unique
  submission       FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status           ApprovalStatus @default(PENDING)
  currentStepOrder Int?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  actions ApprovalAction[]
}

model ApprovalAction {
  id                  String           @id @default(uuid())
  instanceId          String
  instance            ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId              String
  step                ApprovalStep     @relation(fields: [stepId], references: [id])
  approverId          String
  approver            User             @relation(fields: [approverId], references: [id])
  action              ApprovalStatus
  comments            String?
  signatureStorageKey String?
  signatureMimeType   String?
  createdAt           DateTime         @default(now())
}

// ─── User Info & Relatives ────────────────────────────────────────mehrak
model UserInfo {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // مشخصات فردی
  firstName    String?
  lastName     String?
  fatherName   String?
  birthDate    String?
  nationalCode String? @unique
  birthPlace   String?
  residence    String?
  mobile       String?
  homePhone    String?

  // مشخصات تحصیلی
  degree       String?
  university   String?
  graduateYear String?

  relatives Relative[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Relative {
  id         String   @id @default(uuid())
  userInfoId String
  userInfo   UserInfo @relation(fields: [userInfoId], references: [id], onDelete: Cascade)

  name     String
  relation String // مثلاً: پدر، مادر، برادر
  address  String?
  phone    String?
}

model RepairCase {
  id String @id @default(uuid())

  caseNumber String @unique

  customerId String

  type RepairType

  status RepairStatus

  technicianId String?

  description String?

  needCostApproval Boolean @default(false)

  estimatedCost Decimal? @db.Decimal(12, 2)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deviceTitle String

  serialNumber String?

  problemDescription String
  customer           Customer      @relation(fields: [customerId], references: [id])
  technician         User?         @relation("TechnicianRepairs", fields: [technicianId], references: [id])
  visits             RepairVisit[]

  parts      RepairItem[]
  statusLogs RepairStatusLog[]
  sla        RepairSla?
  // notificationEvents NotificationEvent[]
}

model RepairItem {
  id String @id @default(uuid())

  repairCaseId String

  title String

  quantity Int

  unitPrice Decimal @db.Decimal(12, 2)

  description String?

  createdAt DateTime @default(now())

  repairCase RepairCase @relation(fields: [repairCaseId], references: [id])
}

enum RepairType {
  IN_HOUSE
  ON_SITE
}

enum RepairStatus {
  REGISTERED

  WAITING_REVIEW

  WAITING_COST_APPROVAL

  APPROVED

  REJECTED

  IN_REPAIR

  QC

  READY_FOR_DELIVERY

  DELIVERED

  CLOSED

  CANCELED

  NO_REPAIR_REQUIRED
}

model RepairVisit {
  id String @id @default(uuid())

  repairCaseId String

  technicianId String

  technician User @relation("TechnicianVisits", fields: [technicianId], references: [id])

  scheduledAt DateTime

  visitedAt DateTime?

  notes String?

  result VisitResult

  createdAt DateTime @default(now())

  repairCase RepairCase @relation(fields: [repairCaseId], references: [id])
}

enum VisitResult {
  REPAIRED
  NEED_SECOND_VISIT
  NEED_PART
  CUSTOMER_ABSENT
  CANCELED
}

model RepairStatusLog {
  id String @id @default(uuid())

  repairCaseId String

  oldStatus RepairStatus?

  newStatus RepairStatus

  changedById String

  reason String?

  imageStorageKey String?

  imageMimeType String?

  createdAt DateTime @default(now())

  repairCase RepairCase @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)

  changedBy User @relation("UserStatusChanges", fields: [changedById], references: [id])
}

model RepairSla {
  id String @id @default(uuid())

  repairCaseId String     @unique
  repairCase   RepairCase @relation(fields: [repairCaseId], references: [id], onDelete: Cascade)

  targetHours Int
  dueAt       DateTime

  completedAt DateTime?

  isBreached Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RepairSlaPolicy {
  id          String     @id @default(uuid())
  type        RepairType @unique
  targetHours Int
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model NotificationEvent {
  id String @id @default(uuid())

  repairCaseId String

  status RepairStatus

  payload Json

  sentAt DateTime?

  createdAt DateTime @default(now())
}

enum Gender {
  MALE
  FEMALE
}

enum CustomerType {
  PERSON
  ORGANIZATION
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLACKLISTED
}

enum OccupationGroup {
  HAIR_TRANSPLANT_TECHNICIAN // تکنسین کاشت مو
  NAIL_TECHNICIAN // تکنسین کاشت ناخن
  GENERAL_PRACTITIONER // پزشک عمومی
  PHYSICIAN // پزشک
  HAIR_BEAUTY_CLINIC // کلینیک کاشت مو و زیبایی
  HOME_DEVICE_CUSTOMER // مشتری حضوری دستگاه خانگی
  BARBER // آرایشگر
  DENTIST // دندانپزشک
  VETERINARIAN // دامپزشک
  COLLEAGUE // همکار
  EMPLOYEE // کارمند
  DERMATOLOGIST // متخصص پوست و مو
  GYNECOLOGIST // متخصص زنان
  OTHER // سایر
}

enum SalesOpportunityStatus {
  NEW
  CONTACTED
  NEEDS_QUOTE
  QUOTED
  NEGOTIATION
  WON
  LOST
  CANCELED
}

enum SalesOpportunityPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CustomerActivityType {
  NOTE
  CALL
  SMS
  VISIT
  FOLLOW_UP

  CUSTOMER_CREATED
  CUSTOMER_UPDATED

  CONTACT_CREATED
  CONTACT_UPDATED
  CONTACT_DELETED

  SALES_OPPORTUNITY_CREATED
  SALES_OPPORTUNITY_UPDATED
  SALES_OPPORTUNITY_DELETED

  REPAIR_CREATED
  REPAIR_STATUS_CHANGED

  AI_ANALYSIS_UPDATED
}

enum AiInsightLevel {
  LOW
  MEDIUM
  HIGH
}

model Customer {
  id String @id @default(uuid())

  // نوع مشتری: شخص حقیقی یا سازمان
  type   CustomerType   @default(PERSON)
  status CustomerStatus @default(ACTIVE)

  // اطلاعات شخص حقیقی
  firstName    String?
  lastName     String?
  nationalCode String? @unique
  birthDate    String?
  gender       Gender?

  // اطلاعات سازمان / شرکت / کلینیک
  organizationName String?
  economicCode     String? @unique
  registrationNo   String? @unique
  nationalId       String? @unique

  // اطلاعات تماس مشترک
  mobile     String?
  phone      String?
  email      String?
  province   String?
  city       String?
  address    String?
  postalCode String?

  // دسته‌بندی کاری مشتری برای کارفرما
  occupation      String?
  occupationGroup OccupationGroup?

  registeredAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  repairs            RepairCase[]
  addresses          CustomerAddress[]
  contacts           CustomerContact[]
  salesOpportunities SalesOpportunity[]
  activities         CustomerActivity[]
  aiAnalyses         CustomerAiAnalysis[]
  outboundRequests   OutboundRequest[]

  @@index([type])
  @@index([status])
  @@index([mobile])
  @@index([phone])
  @@index([email])
  @@index([organizationName])
  @@index([firstName, lastName])
  @@index([occupationGroup])
}

model CustomerAddress {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title      String?
  province   String?
  city       String?
  address    String?
  postalCode String?
  map        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

model CustomerContact {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  fullName  String
  role      String?
  mobile    String?
  phone     String?
  email     String?
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([mobile])
  @@index([email])
}

model SalesOpportunity {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  title       String
  description String?

  status   SalesOpportunityStatus   @default(NEW)
  priority SalesOpportunityPriority @default(MEDIUM)

  estimatedValue Decimal? @db.Decimal(12, 2)
  probability    Int?     @default(0)

  expectedCloseAt DateTime?
  nextFollowUpAt  DateTime?

  lossReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([priority])
  @@index([nextFollowUpAt])
  @@index([expectedCloseAt])
}

model CustomerActivity {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  type  CustomerActivityType
  title String
  body  String?

  relatedRepairId           String?
  relatedSalesOpportunityId String?

  dueAt DateTime?

  createdById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([type])
  @@index([createdAt])
  @@index([dueAt])
  @@index([relatedRepairId])
  @@index([relatedSalesOpportunityId])
}

model CustomerAiAnalysis {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  summary        String
  riskLevel      AiInsightLevel?
  salesPotential AiInsightLevel?
  nextBestAction String?

  tags     Json?
  insights Json?

  source    String  @default("manual")
  modelName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([riskLevel])
  @@index([salesPotential])
  @@index([createdAt])
}

// ─── Recruitment (independent from internal Forms) ──────────────

enum RecruitmentFormType {
  PRE_INTERVIEW
  INITIAL_INTERVIEW
  TECHNICAL_INTERVIEW
  SUPERADMIN_REVIEW
  PROFILE_COMPLETION
}

enum RecruitmentApplicationStatus {
  DRAFT
  IN_PROGRESS
  REJECTED
  WITHDRAWN
  HIRED
  CANCELLED
}

enum RecruitmentStage {
  PRE_INTERVIEW_FORM
  INITIAL_REVIEW
  INITIAL_INTERVIEW
  TECHNICAL_INTERVIEW_ASSIGNMENT
  TECHNICAL_INTERVIEW
  SUPERADMIN_APPROVAL
  ACCOUNT_PROVISIONING
  PROFILE_COMPLETION
  COMPLETED
}

enum RecruitmentActorType {
  APPLICANT
  USER
  SYSTEM
}

enum RecruitmentAction {
  SUBMIT_PRE_INTERVIEW
  APPROVE_INITIAL_REVIEW
  REJECT_INITIAL_REVIEW
  SUBMIT_INITIAL_INTERVIEW
  APPROVE_INITIAL_INTERVIEW
  REJECT_INITIAL_INTERVIEW
  ASSIGN_TECHNICAL_INTERVIEWER
  SUBMIT_TECHNICAL_INTERVIEW
  APPROVE_TECHNICAL_INTERVIEW
  REJECT_TECHNICAL_INTERVIEW
  FINAL_APPROVE
  FINAL_REJECT
  CREATE_USER_ACCOUNT
  COMPLETE_PROFILE
  WITHDRAW
  REASSIGN
}

enum InterviewRecommendation {
  STRONG_HIRE
  HIRE
  NO_HIRE
  STRONG_NO_HIRE
}

model RecruitmentFormTemplate {
  id                   String                   @id @default(uuid())
  name                 String
  description          String?
  type                 RecruitmentFormType
  isActive             Boolean                  @default(true)
  versions             RecruitmentFormVersion[]
  jobOpeningsPre       JobOpening[]             @relation("PreInterviewForm")
  jobOpeningsInitial   JobOpening[]             @relation("InitialInterviewForm")
  jobOpeningsTechnical JobOpening[]             @relation("TechnicalInterviewForm")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([type, isActive])
}

model RecruitmentFormVersion {
  id          String                      @id @default(uuid())
  templateId  String
  version     Int
  schema      Json
  isPublished Boolean                     @default(false)
  publishedAt DateTime?
  template    RecruitmentFormTemplate     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissions RecruitmentFormSubmission[]
  createdAt   DateTime                    @default(now())

  @@unique([templateId, version])
  @@index([templateId, isPublished])
}

model JobOpening {
  id                       String                   @id @default(uuid())
  title                    String
  slug                     String                   @unique
  description              String?
  departmentId             String?
  isActive                 Boolean                  @default(true)
  preInterviewFormId       String
  initialInterviewFormId   String?
  technicalInterviewFormId String?
  initialReviewerRoleId    String?
  department               Department?              @relation(fields: [departmentId], references: [id])
  preInterviewForm         RecruitmentFormTemplate  @relation("PreInterviewForm", fields: [preInterviewFormId], references: [id])
  initialInterviewForm     RecruitmentFormTemplate? @relation("InitialInterviewForm", fields: [initialInterviewFormId], references: [id])
  technicalInterviewForm   RecruitmentFormTemplate? @relation("TechnicalInterviewForm", fields: [technicalInterviewFormId], references: [id])
  applications             RecruitmentApplication[]
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt

  @@index([isActive])
}

model RecruitmentApplicant {
  id              String                   @id @default(uuid())
  fullName        String
  phoneNumber     String
  normalizedPhone String
  email           String?
  nationalCode    String?
  applications    RecruitmentApplication[]
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([normalizedPhone])
  @@index([nationalCode])
}

model RecruitmentApplication {
  id                      String                        @id @default(uuid())
  trackingCode            String                        @unique
  publicTokenHash         String                        @unique
  applicantId             String
  jobOpeningId            String
  status                  RecruitmentApplicationStatus  @default(IN_PROGRESS)
  currentStage            RecruitmentStage              @default(INITIAL_REVIEW)
  finalUserId             String?                       @unique
  rejectionReasonInternal String?
  rejectionMessagePublic  String?
  version                 Int                           @default(0)
  submittedAt             DateTime                      @default(now())
  rejectedAt              DateTime?
  hiredAt                 DateTime?
  applicant               RecruitmentApplicant          @relation(fields: [applicantId], references: [id])
  jobOpening              JobOpening                    @relation(fields: [jobOpeningId], references: [id])
  finalUser               User?                         @relation("RecruitmentFinalUser", fields: [finalUserId], references: [id])
  submissions             RecruitmentFormSubmission[]
  assignments             RecruitmentAssignment[]
  transitions             RecruitmentTransition[]
  technicalEvaluation     TechnicalInterviewEvaluation?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt

  @@index([status, currentStage])
  @@index([jobOpeningId, createdAt])
}

model RecruitmentFormSubmission {
  id                String                 @id @default(uuid())
  applicationId     String
  formVersionId     String
  stage             RecruitmentStage
  answers           Json
  submittedByType   RecruitmentActorType
  submittedByUserId String?
  application       RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  formVersion       RecruitmentFormVersion @relation(fields: [formVersionId], references: [id])
  submittedByUser   User?                  @relation(fields: [submittedByUserId], references: [id])
  createdAt         DateTime               @default(now())

  @@unique([applicationId, stage])
  @@index([formVersionId])
}

model RecruitmentAssignment {
  id               String                 @id @default(uuid())
  applicationId    String
  stage            RecruitmentStage
  assigneeUserId   String
  assignedByUserId String
  assignedAt       DateTime               @default(now())
  completedAt      DateTime?
  revokedAt        DateTime?
  application      RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  assignee         User                   @relation("RecruitmentAssignee", fields: [assigneeUserId], references: [id])
  assignedBy       User                   @relation("RecruitmentAssignedBy", fields: [assignedByUserId], references: [id])

  @@index([assigneeUserId, stage, completedAt])
  @@index([applicationId, stage])
}

model RecruitmentTransition {
  id            String                 @id @default(uuid())
  applicationId String
  fromStage     RecruitmentStage?
  toStage       RecruitmentStage
  action        RecruitmentAction
  actorType     RecruitmentActorType
  actorUserId   String?
  reasonCode    String?
  comment       String?
  metadata      Json?
  application   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorUser     User?                  @relation(fields: [actorUserId], references: [id])
  createdAt     DateTime               @default(now())

  @@index([applicationId, createdAt])
}

model TechnicalInterviewEvaluation {
  id              String                  @id @default(uuid())
  applicationId   String                  @unique
  interviewerId   String
  overallScore    Int
  recommendation  InterviewRecommendation
  internalSummary String
  completedAt     DateTime                @default(now())
  application     RecruitmentApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([interviewerId])
}
// ═══════════════════════════════════════════════════════════════
// Commerce (بازرگانی) & Warehouse (انبار)
// ═══════════════════════════════════════════════════════════════

model SequenceCounter {
  key   String @id
  value Int    @default(0)
}

// ─── Suppliers ────────────────────────────────────────────────

enum SupplierKind {
  GOODS
  TRANSPORT
}

enum SupplierEntityType {
  PERSON
  COMPANY
}

enum SupplierLabel {
  WHITE
  GRAY
  BLACK
}

enum EvaluationType {
  INITIAL
  PERIODIC
}

model Supplier {
  id         String             @id @default(uuid())
  kind       SupplierKind
  entityType SupplierEntityType

  // person
  firstName String?
  lastName  String?

  // company
  companyName         String?
  representativeName  String?
  representativePhone String?
  accountantName      String?
  accountantPhone     String?

  // shared
  phone    String?
  address  String?
  isActive Boolean @default(true)

  // derived from latest evaluation
  score           Decimal?       @db.Decimal(5, 2)
  label           SupplierLabel?
  lastEvaluatedAt DateTime?
  lastPurchaseAt  DateTime?
  periodicDueAt   DateTime?
  lastReminderAt  DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products           SupplierProduct[]
  evaluations        SupplierEvaluation[]
  goodsOrders        PurchaseOrder[]      @relation("OrderGoodsSupplier")
  transportOrders    PurchaseOrder[]      @relation("OrderTransportSupplier")
  outboundDispatches OutboundDispatch[]

  @@index([kind, entityType])
  @@index([label])
  @@index([lastName, firstName])
  @@index([companyName])
}

// For GOODS suppliers: productId is set. For TRANSPORT suppliers: title (service) + price (shipping cost).
model SupplierProduct {
  id         String   @id @default(uuid())
  supplierId String
  productId  String?
  title      String?
  unitPrice  Decimal? @db.Decimal(18, 2)
  note       String?
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([productId])
}

model EvaluationTemplate {
  id           String         @id @default(uuid())
  supplierKind SupplierKind
  type         EvaluationType
  version      Int
  isActive     Boolean        @default(true)
  title        String
  description  String?
  createdById  String?
  createdAt    DateTime       @default(now())

  questions   EvaluationQuestion[]
  evaluations SupplierEvaluation[]

  @@unique([supplierKind, type, version])
  @@index([supplierKind, type, isActive])
}

model EvaluationQuestion {
  id         String  @id @default(uuid())
  templateId String
  order      Int
  text       String
  weight     Decimal @db.Decimal(8, 2)
  // {"0": "...", "1": "...", "2": "...", "3": "..."}
  guide      Json

  template EvaluationTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  answers  SupplierEvaluationAnswer[]

  @@index([templateId, order])
}

model SupplierEvaluation {
  id            String         @id @default(uuid())
  supplierId    String
  templateId    String
  type          EvaluationType
  score         Decimal        @db.Decimal(5, 2)
  label         SupplierLabel
  notes         String?
  evaluatedById String?
  evaluatedAt   DateTime       @default(now())

  supplier Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  template EvaluationTemplate         @relation(fields: [templateId], references: [id])
  answers  SupplierEvaluationAnswer[]

  @@index([supplierId, evaluatedAt])
}

model SupplierEvaluationAnswer {
  id           String  @id @default(uuid())
  evaluationId String
  questionId   String?
  questionText String
  weight       Decimal @db.Decimal(8, 2)
  score        Int

  evaluation SupplierEvaluation  @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  question   EvaluationQuestion? @relation(fields: [questionId], references: [id], onDelete: SetNull)

  @@index([evaluationId])
}

model SupplierScoreSetting {
  id          String   @id @default("default")
  whiteMin    Decimal  @default(60) @db.Decimal(5, 2)
  grayMin     Decimal  @default(40) @db.Decimal(5, 2)
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ─── Products ─────────────────────────────────────────────────

model ProductType {
  id            String   @id @default(uuid())
  code          String   @unique // 2 digits
  name          String
  profitPercent Decimal  @default(0) @db.Decimal(7, 2)
  createdAt     DateTime @default(now())

  categories ProductCategory[]
  products   Product[]
}

model ProductCategory {
  id        String   @id @default(uuid())
  typeId    String
  code      String // 3 digits
  name      String
  createdAt DateTime @default(now())

  type     ProductType @relation(fields: [typeId], references: [id])
  products Product[]

  @@unique([typeId, code])
}

model Product {
  id         String @id @default(uuid())
  code       String @unique // 9 digits = type(2) + category(3) + item(4)
  typeId     String
  categoryId String
  itemCode   String // 4 digits, manual

  // name parts (all optional) — fullName = type.name + category.name + parts below
  definitionSuffix String? // پس کد تعریف محصول
  brand            String?
  model            String?
  grade            String? // اکونومی / درجه ۱
  extraPrefix      String? // پیش کد اضافه
  color            String? // رنگ و کد رنگ
  fullName         String  @unique

  trackSerial Boolean @default(false)
  isActive    Boolean @default(true)

  lastPurchasePrice Decimal?  @db.Decimal(18, 2)
  lastPurchaseAt    DateTime?
  currentPrice      Decimal?  @db.Decimal(18, 2)
  priceReviewNeeded Boolean   @default(false)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  type     ProductType     @relation(fields: [typeId], references: [id])
  category ProductCategory @relation(fields: [categoryId], references: [id])

  prices         ProductPrice[]
  suppliers      SupplierProduct[]
  requestItems   PurchaseRequestItem[]
  orderItems     PurchaseOrderItem[]
  stockItems     StockItem[]
  transferLines  StockTransferLine[]
  outboundItems  OutboundRequestItem[]
  dispatchLines  OutboundDispatchLine[]
  stocktakeLines StocktakeLine[]

  @@unique([typeId, categoryId, itemCode])
  @@index([typeId, categoryId])
  @@index([fullName])
}

model PricingSetting {
  id               String   @id @default("default")
  overheadPercent  Decimal  @default(0) @db.Decimal(7, 2)
  profitTaxPercent Decimal  @default(0) @db.Decimal(7, 2)
  vatPercent       Decimal  @default(0) @db.Decimal(7, 2)
  shippingPercent  Decimal  @default(0) @db.Decimal(7, 2)
  updatedById      String?
  updatedAt        DateTime @updatedAt
}

model ProductPrice {
  id                String   @id @default(uuid())
  productId         String
  purchasePrice     Decimal  @db.Decimal(18, 2)
  overheadPercent   Decimal  @db.Decimal(7, 2)
  profitTaxPercent  Decimal  @db.Decimal(7, 2)
  vatPercent        Decimal  @db.Decimal(7, 2)
  shippingPercent   Decimal  @db.Decimal(7, 2)
  typeProfitPercent Decimal  @db.Decimal(7, 2)
  totalPercent      Decimal  @db.Decimal(8, 2)
  costPrice         Decimal  @db.Decimal(18, 2) // قیمت تمام شده
  sellingPrice      Decimal  @db.Decimal(18, 2)
  differenceAmount  Decimal  @db.Decimal(18, 2) // selling - cost
  profitLossPercent Decimal  @db.Decimal(9, 2) // vs purchase price
  isCurrent         Boolean  @default(true)
  approvedById      String?
  approvedAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, isCurrent])
  @@index([productId, approvedAt])
}

// ─── Purchase requests & orders ───────────────────────────────

enum PurchaseRequestStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

enum PurchaseOrderStatus {
  INITIAL
  FOLLOW_UP
  PURCHASED
  FINALIZED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CREDIT
}

enum DeliveryMode {
  SUPPLIER_DELIVERY
  TRANSPORT_SUPPLIER
}

model PurchaseRequest {
  id           String                @id @default(uuid())
  number       String                @unique
  requesterId  String
  status       PurchaseRequestStatus @default(PENDING_APPROVAL)
  neededBy     DateTime?
  notes        String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  requester User                  @relation("PurchaseRequester", fields: [requesterId], references: [id])
  items     PurchaseRequestItem[]
  orders    PurchaseOrder[]

  @@index([status, createdAt])
  @@index([requesterId])
}

model PurchaseRequestItem {
  id        String  @id @default(uuid())
  requestId String
  productId String
  quantity  Int
  note      String?

  request    PurchaseRequest     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id])
  orderItems PurchaseOrderItem[]

  @@index([requestId])
}

model PurchaseOrder {
  id                  String              @id @default(uuid())
  number              String              @unique
  requestId           String?
  requesterId         String? // سفارش‌دهنده
  buyerId             String // مسئول خرید
  supplierId          String
  status              PurchaseOrderStatus @default(INITIAL)
  orderedAt           DateTime            @default(now())
  expectedDeliveryAt  DateTime?
  deliveryMode        DeliveryMode        @default(SUPPLIER_DELIVERY)
  transportSupplierId String?
  transportCost       Decimal?            @db.Decimal(18, 2)
  paymentMethod       PaymentMethod
  warehouseId         String
  notes               String?
  purchasedAt         DateTime?
  finalizedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  request           PurchaseRequest?         @relation(fields: [requestId], references: [id])
  requester         User?                    @relation("PurchaseOrderRequester", fields: [requesterId], references: [id])
  buyer             User                     @relation("PurchaseOrderBuyer", fields: [buyerId], references: [id])
  supplier          Supplier                 @relation("OrderGoodsSupplier", fields: [supplierId], references: [id])
  transportSupplier Supplier?                @relation("OrderTransportSupplier", fields: [transportSupplierId], references: [id])
  warehouse         Warehouse                @relation(fields: [warehouseId], references: [id])
  items             PurchaseOrderItem[]
  statusLogs        PurchaseOrderStatusLog[]

  @@index([status, createdAt])
  @@index([supplierId])
  @@index([warehouseId])
}

model PurchaseOrderItem {
  id               String   @id @default(uuid())
  orderId          String
  productId        String
  requestItemId    String?
  quantity         Int
  receivedQuantity Int      @default(0)
  unitPrice        Decimal? @db.Decimal(18, 2)

  order       PurchaseOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product              @relation(fields: [productId], references: [id])
  requestItem PurchaseRequestItem? @relation(fields: [requestItemId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model PurchaseOrderStatusLog {
  id         String               @id @default(uuid())
  orderId    String
  fromStatus PurchaseOrderStatus?
  toStatus   PurchaseOrderStatus
  userId     String?
  note       String?
  createdAt  DateTime             @default(now())

  order PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

// ─── Warehouses ───────────────────────────────────────────────

model Warehouse {
  id        String   @id @default(uuid())
  number    String   @unique
  name      String
  address   String?
  parentId  String?
  keeperId  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Warehouse?  @relation("WarehouseTree", fields: [parentId], references: [id])
  children Warehouse[] @relation("WarehouseTree")
  keeper   User?       @relation("WarehouseKeeper", fields: [keeperId], references: [id])

  stockItems      StockItem[]
  invoices        WarehouseInvoice[]   @relation("InvoiceWarehouse")
  counterInvoices WarehouseInvoice[]   @relation("InvoiceCounterWarehouse")
  purchaseOrders  PurchaseOrder[]
  transfersFrom   StockTransfer[]      @relation("TransferFrom")
  transfersTo     StockTransfer[]      @relation("TransferTo")
  dispatches      OutboundDispatch[]
  stocktakeSheets StocktakeWarehouse[]

  @@index([keeperId])
  @@index([parentId])
}

model StockItem {
  id              String    @id @default(uuid())
  productId       String
  warehouseId     String
  lotNumber       String
  serialNumber    String?
  manufactureDate DateTime?
  expiryDate      DateTime?
  quantity        Int
  invoiceId       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([warehouseId, productId])
  @@index([productId, serialNumber])
  @@index([productId, lotNumber])
}

enum WarehouseInvoiceType {
  RECEIPT
  TRANSFER
  ISSUE
  ADJUSTMENT
}

model WarehouseInvoice {
  id                 String               @id @default(uuid())
  number             String               @unique
  type               WarehouseInvoiceType
  warehouseId        String
  counterWarehouseId String?
  refType            String? // PURCHASE_ORDER | TRANSFER | OUTBOUND_DISPATCH | STOCKTAKE
  refId              String?
  lines              Json // snapshot [{productId, code, name, lotNumber, serialNumber, manufactureDate, expiryDate, quantity}]
  notes              String?
  issuedById         String?
  issuedAt           DateTime             @default(now())

  warehouse        Warehouse  @relation("InvoiceWarehouse", fields: [warehouseId], references: [id])
  counterWarehouse Warehouse? @relation("InvoiceCounterWarehouse", fields: [counterWarehouseId], references: [id])

  @@index([type, issuedAt])
  @@index([warehouseId, issuedAt])
  @@index([refType, refId])
}

// ─── Transfers between warehouses ─────────────────────────────

enum StockTransferStatus {
  REQUESTED
  REJECTED
  IN_TRANSIT
  RECEIVED
}

model StockTransfer {
  id              String              @id @default(uuid())
  number          String              @unique
  fromWarehouseId String
  toWarehouseId   String
  requestedById   String
  status          StockTransferStatus @default(REQUESTED)
  notes           String?
  decidedById     String?
  decidedAt       DateTime?
  rejectReason    String?
  receivedById    String?
  receivedAt      DateTime?
  invoiceId       String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  requestedBy   User                @relation("TransferRequester", fields: [requestedById], references: [id])
  lines         StockTransferLine[]

  @@index([status, createdAt])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockTransferLine {
  id                String @id @default(uuid())
  transferId        String
  productId         String
  requestedQuantity Int
  // snapshot of picked stock at approval: [{lotNumber, serialNumber, manufactureDate, expiryDate, quantity}]
  sentItems         Json?

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
}

// ─── Outbound (خروج کالا) ─────────────────────────────────────

enum OutboundRequestStatus {
  PENDING_ALLOCATION
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OutboundDispatchStatus {
  PENDING_KEEPER
  REJECTED
  PREPARING
  READY_FOR_DELIVERY
  DELIVERED
}

enum DeliveryType {
  IN_PERSON
  INTERNAL_TRANSPORT
  FREIGHT
}

model OutboundRequest {
  id              String                @id @default(uuid())
  number          String                @unique
  saleOrderNumber String? // from sales module when it exists
  customerId      String?
  requestedById   String
  status          OutboundRequestStatus @default(PENDING_ALLOCATION)
  notes           String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  customer    Customer?             @relation(fields: [customerId], references: [id])
  requestedBy User                  @relation("OutboundRequester", fields: [requestedById], references: [id])
  items       OutboundRequestItem[]
  dispatches  OutboundDispatch[]

  @@index([status, createdAt])
  @@index([customerId])
}

model OutboundRequestItem {
  id        String @id @default(uuid())
  requestId String
  productId String
  quantity  Int

  request OutboundRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])

  @@index([requestId])
}

model OutboundDispatch {
  id                  String                 @id @default(uuid())
  requestId           String
  warehouseId         String
  status              OutboundDispatchStatus @default(PENDING_KEEPER)
  rejectReason        String?
  approvedById        String?
  approvedAt          DateTime?
  videoStorageKey     String?
  videoMimeType       String?
  videoOriginalName   String?
  preparedAt          DateTime?
  deliveryType        DeliveryType?
  receiverName        String?
  receiverPhone       String?
  transportSupplierId String?
  transportNote       String?
  readyAt             DateTime?
  deliveredAt         DateTime?
  deliveredById       String?
  invoiceId           String?
  pickedItems         Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  request           OutboundRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  warehouse         Warehouse              @relation(fields: [warehouseId], references: [id])
  transportSupplier Supplier?              @relation(fields: [transportSupplierId], references: [id])
  lines             OutboundDispatchLine[]

  @@index([requestId])
  @@index([warehouseId, status])
}

model OutboundDispatchLine {
  id         String @id @default(uuid())
  dispatchId String
  productId  String
  quantity   Int

  dispatch OutboundDispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product          @relation(fields: [productId], references: [id])

  @@index([dispatchId])
}

// ─── Stocktake (انبارگردانی) ──────────────────────────────────

enum StocktakeStatus {
  COUNTING
  COMPLETED
  CANCELLED
}

enum StocktakeWarehouseStatus {
  COUNTING
  SUBMITTED
  RETURNED
}

model Stocktake {
  id            String          @id @default(uuid())
  number        String          @unique
  status        StocktakeStatus @default(COUNTING)
  notes         String?
  startedById   String
  startedAt     DateTime        @default(now())
  completedById String?
  completedAt   DateTime?

  warehouses StocktakeWarehouse[]

  @@index([status])
}

model StocktakeWarehouse {
  id          String                   @id @default(uuid())
  stocktakeId String
  warehouseId String
  status      StocktakeWarehouseStatus @default(COUNTING)
  returnNote  String?
  submittedAt DateTime?

  stocktake Stocktake       @relation(fields: [stocktakeId], references: [id], onDelete: Cascade)
  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  lines     StocktakeLine[]

  @@unique([stocktakeId, warehouseId])
}

model StocktakeLine {
  id                   String @id @default(uuid())
  stocktakeWarehouseId String
  productId            String
  systemQuantity       Int
  countedQuantity      Int?

  sheet   StocktakeWarehouse @relation(fields: [stocktakeWarehouseId], references: [id], onDelete: Cascade)
  product Product            @relation(fields: [productId], references: [id])

  @@unique([stocktakeWarehouseId, productId])
}

