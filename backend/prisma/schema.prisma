generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ScopeType {
  SELF
  TEAM
  DEPARTMENT
  DEPARTMENT_SUBTREE
  RELATED_DEPARTMENTS
  ORG_WIDE
}

enum DepartmentRelationType {
  SUPPORTS
  COLLABORATES
  AUDITS
  SERVES
}

model Department {
  id       String  @id @default(uuid())
  name     String
  parentId String?

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children Department[] @relation("DepartmentHierarchy")

  users             User[]
  outgoingRelations DepartmentRelation[] @relation("FromDepartment")
  incomingRelations DepartmentRelation[] @relation("ToDepartment")

  createdAt DateTime @default(now())
}

model DepartmentRelation {
  id               String                 @id @default(uuid())
  fromDepartmentId String
  toDepartmentId   String
  type             DepartmentRelationType

  fromDepartment Department @relation("FromDepartment", fields: [fromDepartmentId], references: [id])
  toDepartment   Department @relation("ToDepartment", fields: [toDepartmentId], references: [id])

  @@unique([fromDepartmentId, toDepartmentId, type])
}

model User {
  id           String  @id @default(uuid())
  phoneNumber  String  @unique
  name         String
  departmentId String
  managerId    String?
  refreshToken String?

  department   Department      @relation(fields: [departmentId], references: [id])
  manager      User?           @relation("UserHierarchy", fields: [managerId], references: [id])
  subordinates User[]          @relation("UserHierarchy")
  roles        UserRole[]
  submissions  FormSubmission[]
  userInfo  UserInfo?//mehrak
  baleChatId   String?//mehrak

  createdAt DateTime @default(now())

  approvalActions ApprovalAction[]
  employeeCode String? @unique
  attendances  Attendance[]
  assignedRepairs RepairCase[]@relation("TechnicianRepairs")
  repairVisits RepairVisit[] @relation("TechnicianVisits")
  statusLogs RepairStatusLog[] @relation("UserStatusChanges")
}
model Attendance {
  id        String   @id @default(uuid())
  userId    String
  date      DateTime @db.Date
  checkTime DateTime
  source    String   @default("excel-import")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, checkTime])
  @@index([userId, date])
}
model Role {
  id   String @id @default(uuid())
  name String @unique

  permissions RolePermission[]
  users       UserRole[]

  approvalSteps ApprovalStep[]
}

model Permission {
  id       String @id @default(uuid())
  action   String
  resource String

  roles RolePermission[]

  @@unique([action, resource])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id] ,onDelete: Cascade )
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

model RolePermission {
  id           String                  @id @default(uuid())
  roleId       String
  permissionId String
  scope        ScopeType
  relationType DepartmentRelationType?
  constraints  Json?

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@unique([roleId, permissionId])
}

// ─── Forms & Analytics ────────────────────────────────────────

model Form {
  id          String  @id @default(uuid())
  ownerId     String
  customId    String? @unique  // ← شناسه دستی یکتا

  name        String
  description String?
  schema      Json
  version     Int     @default(1)
  isActive    Boolean @default(true)

  submissions FormSubmission[]
  stats       FormStat[]
  analysis    FormAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvalPolicies ApprovalPolicy[]
}

model FormSubmission {
  id          String  @id @default(uuid())
  formId      String
  formVersion Int
  userId      String?
  data        Json

  form Form  @relation(fields: [formId], references: [id])
  user User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  approvalInstances ApprovalInstance[]
}

model FormStat {
  id      String @id @default(uuid())
  formId  String
  fieldId String
  metric  String
  value   Json

  form Form @relation(fields: [formId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([formId, fieldId, metric])
}

model FormAnalysis {
  id      String  @id @default(uuid())
  formId  String
  fieldId String?
  metric  String
  value   Json
  source  String  @default("analytics-worker")

  form Form @relation(fields: [formId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([formId, fieldId, metric])
  @@index([formId])
}

// ─── Approval Workflow ────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalPolicy {
  id        String   @id @default(uuid())
  formId    String   @unique
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps ApprovalStep[]
}

model ApprovalStep {
  id        String         @id @default(uuid())
  policyId  String
  policy    ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  stepOrder Int
  roleId    String
  role      Role           @relation(fields: [roleId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([policyId, stepOrder])
  approvalActions ApprovalAction[]
}

model ApprovalInstance {
  id               String           @id @default(uuid())
  submissionId     String           @unique
  submission       FormSubmission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  status           ApprovalStatus   @default(PENDING)
  currentStepOrder Int?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  actions ApprovalAction[]
}

model ApprovalAction {
  id         String           @id @default(uuid())
  instanceId String
  instance   ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  stepId     String
  step       ApprovalStep     @relation(fields: [stepId], references: [id])
  approverId String
  approver   User             @relation(fields: [approverId], references: [id])
  action     ApprovalStatus
  comments   String?
  createdAt  DateTime         @default(now())
}

// ─── User Info & Relatives ────────────────────────────────────────mehrak
model UserInfo {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // مشخصات فردی
  firstName    String?
  lastName     String?
  fatherName   String?
  birthDate    String?
  nationalCode String?  @unique
  birthPlace   String?
  residence    String?
  mobile       String?
  homePhone    String?

  // مشخصات تحصیلی
  degree       String?
  university   String?
  graduateYear String?

  relatives    Relative[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Relative {
  id         String   @id @default(uuid())
  userInfoId String
  userInfo   UserInfo @relation(fields: [userInfoId], references: [id], onDelete: Cascade)

  name     String
  relation String   // مثلاً: پدر، مادر، برادر
  address  String?
  phone    String?

}

model RepairCase {
  id String @id @default(uuid())

  caseNumber String @unique

  customerId String


  type RepairType

  status RepairStatus

  technicianId String?

  description String?

  needCostApproval Boolean @default(false)

  estimatedCost Decimal? @db.Decimal(12,2)

  startedAt DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deviceTitle String

  serialNumber String?

  problemDescription String
  customer Customer @relation(fields: [customerId],references: [id])
  technician User? @relation("TechnicianRepairs",fields: [technicianId],references: [id])
  visits RepairVisit[]

  parts RepairItem[]
  statusLogs RepairStatusLog[]
// notificationEvents NotificationEvent[]
// sla RepairSla?
}
model RepairItem {
  id String @id @default(uuid())

  repairCaseId String

  title String

  quantity Int

  unitPrice Decimal @db.Decimal(12,2)

  description String?

  createdAt DateTime @default(now())

  repairCase RepairCase @relation( fields: [repairCaseId], references: [id])
}
enum RepairType {
  IN_HOUSE
  ON_SITE
}
enum RepairStatus {
  REGISTERED

  WAITING_REVIEW

  WAITING_COST_APPROVAL

  APPROVED

  REJECTED

  IN_REPAIR

  QC

  READY_FOR_DELIVERY

  DELIVERED

  CLOSED

  CANCELED

  NO_REPAIR_REQUIRED
}

model RepairVisit {
  id String @id @default(uuid())

  repairCaseId String

  technicianId String

  technician User @relation("TechnicianVisits", fields: [technicianId], references: [id])

  scheduledAt DateTime

  visitedAt DateTime?

  notes String?

  result VisitResult

  createdAt DateTime @default(now())

  repairCase RepairCase @relation(fields: [repairCaseId], references: [id])
}
enum VisitResult {
  REPAIRED
  NEED_SECOND_VISIT
  NEED_PART
  CUSTOMER_ABSENT
  CANCELED
}
model RepairStatusLog {
  id String @id @default(uuid())

  repairCaseId String

  oldStatus RepairStatus?

  newStatus RepairStatus

  changedById String

  reason String?

  createdAt DateTime @default(now())

  repairCase RepairCase @relation(fields: [repairCaseId],references: [id],onDelete: Cascade)

  changedBy User @relation("UserStatusChanges",fields: [changedById],references: [id])
}

model RepairSla {
  id String @id @default(uuid())

  repairCaseId String @unique

  dueAt DateTime

  completedAt DateTime?

  isBreached Boolean @default(false)
}
model NotificationEvent {
  id String @id @default(uuid())

  repairCaseId String


  status RepairStatus

  payload Json

  sentAt DateTime?
  
  createdAt DateTime @default(now())
}

enum Gender {
  MALE
  FEMALE
}

enum OccupationGroup {
  HAIR_TRANSPLANT_TECHNICIAN // تکنسین کاشت مو
  NAIL_TECHNICIAN            // تکنسین کاشت ناخن
  GENERAL_PRACTITIONER       // پزشک عمومی
  PHYSICIAN                  // پزشک
  HAIR_BEAUTY_CLINIC         // کلینیک کاشت مو و زیبایی
  HOME_DEVICE_CUSTOMER       // مشتری حضوری دستگاه خانگی
  BARBER                     // آرایشگر
  DENTIST                    // دندانپزشک
  VETERINARIAN               // دامپزشک
  COLLEAGUE                  // همکار
  EMPLOYEE                   // کارمند
  DERMATOLOGIST              // متخصص پوست و مو
  GYNECOLOGIST               // متخصص زنان
  OTHER                      // سایر
}


model Customer {
  id String @id @default(uuid())

  // ─── اطلاعات شخصی (اجباری) ───────────────────────────────
  firstName    String
  lastName     String
  mobile       String
  phone        String
  nationalCode String  @unique
  birthDate    String
  gender       Gender

  // ─── اطلاعات جغرافیایی (اجباری) ─────────────────────────
  province String
  city     String
  address  String

  // ─── اطلاعات شغلی (اجباری) ───────────────────────────────
  occupation      String
  occupationGroup OccupationGroup

  // ─── زمان ثبت (اجباری) ───────────────────────────────────
  registeredAt DateTime @default(now())

  // ─── اطلاعات اختیاری ─────────────────────────────────────
  email      String?
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  repairs RepairCase[]
}